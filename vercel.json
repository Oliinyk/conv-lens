{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/[...route].js": { "includeFiles": "tracker/**", "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/", "destination": "/dashboard/index.html" },
    { "source": "/cl/t.js", "destination": "/api/t" },
    { "source": "/cl/collect", "destination": "/api/collect" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
